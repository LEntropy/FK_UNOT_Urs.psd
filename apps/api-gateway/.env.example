DATABASE_URL=./data/api-gateway.db
PORT=4000
ASSET_SERVICE_URL=http://localhost:3002
# This gateway is the only trusted caller of delivery-gateway's
# /internal/sign -- see apps/delivery-gateway/README.md.
DELIVERY_GATEWAY_URL=http://localhost:4500
# Only needed when this gateway and the browser see delivery-gateway at
# different addresses (e.g. server-to-server uses 127.0.0.1 to dodge an
# IPv6-first "localhost" resolution, but the browser needs the public
# host/port). Defaults to DELIVERY_GATEWAY_URL when unset.
# DELIVERY_GATEWAY_PUBLIC_URL=http://localhost:4500

JWT_ACCESS_SECRET=dev-insecure-access-secret-change-me
JWT_REFRESH_SECRET=dev-insecure-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

KMS_HOST=Philosophyz.iptime.org
KMS_PORT=8443
KMS_CA_CERT_PATH=./kms-keys/kms_ca.crt
KMS_PUBLIC_KEY_PATH=./kms-keys/teamA1_key_v1_pub.pem
KMS_ORG=teamA/teamA1
KMS_KEY_ID=key_v1

# Evidence-bundle signing key (src/evidenceSigning.ts) -- POST
# /internal/sign-evidence, called by detection-svc to fill in evidence
# bundles' "내부 서명" field. Same two-option shape as RELAYER_PRIVATE_KEY
# above (exactly one required):
#   1. Plaintext here, base64-encoded PKCS8 PEM (local dev / tests).
#   2. KMS-wrapped: set EVIDENCE_SIGNING_ENCRYPTED_KEY (base64 RSA-PKCS1
#      ciphertext, produced with `node scripts/generate-evidence-signing-key.mjs`)
#      instead, and leave this unset -- reuses the KMS_* vars above.
EVIDENCE_SIGNING_PRIVATE_KEY=
# EVIDENCE_SIGNING_ENCRYPTED_KEY=

# Social login. Both providers are optional -- leave a pair unset and that
# provider's /auth/:provider route responds 501 instead of erroring.
# Get Google credentials from https://console.cloud.google.com (OAuth client,
# authorized redirect URI: {PUBLIC_URL}/auth/google/callback).
# Get Kakao credentials from https://developers.kakao.com (redirect URI:
# {PUBLIC_URL}/auth/kakao/callback; the "account_email" consent item must be
# enabled or the callback fails with "no email returned").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# PUBLIC_URL is this service's own externally-reachable base URL (used to
# build the OAuth redirect_uri sent to Google/Kakao). WEB_URL is where the
# frontend lives -- the OAuth callback redirects here with tokens in the
# URL hash after a successful login.
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# POST /internal/notify-evidence-ready (src/notify.ts) -- emails a creator
# when detection-svc's pipeline finds real evidence against their artwork.
# Optional, same "degrades gracefully" posture as GOOGLE_VISION_API_KEY:
# without all three of SMTP_HOST/SMTP_USER/SMTP_PASSWORD set, this just
# returns {sent: false} instead of erroring. No real SMTP credentials in
# this dev/demo environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dontai.local

ASSET_SERVICE_URL=http://localhost:3002
PORT=8003

# POST /model-leak-reports' one dependency on another service besides
# asset-service -- model-leak detection needs real GPU inference
# (protection-svc/ml-engine's detect_model_leak), which this service can't
# do itself. See src/protection_client.py's module doc.
PROTECTION_SVC_URL=http://localhost:8010
# Caps a caller-submitted suspect-model download (protection_client.py's
# download_suspect_model) -- generous headroom above a typical SD1.5 LoRA
# (tens of MB), not unbounded. See that function's own doc for why this
# exists at all (an externally-controlled URL, unlike everything else this
# service fetches).
MODEL_LEAK_MAX_BYTES=2147483648
# How long POST /model-leak-reports' background case runner waits for
# protection-svc's /detect-model-leak job to finish before giving up and
# marking the case FAILED -- that job actually generates images (the same
# cost class as a real /protect job), not a quick VGG19 pass.
MODEL_LEAK_POLL_TIMEOUT_SECONDS=1800

# POST /internal/notify-evidence-ready -- emails a creator when a case
# reaches EVIDENCE_READY. api-gateway owns the actual SMTP config (its own
# SMTP_* vars); this is just where detection-svc looks for that endpoint.
API_GATEWAY_URL=http://localhost:4000

# Periodic auto-rescan (server.py's _auto_scan_loop) -- opt-in, off by
# default (see server.py's own comment: a background thread doing real
# outbound HTTP at import time would be a surprising side effect for
# every test file, which all import this module). Set to "1" in a real
# deployment so every published artwork gets checked on a rolling
# schedule, not just at upload time or whenever a creator happens to click
# "웹에서 자동 검색".
AUTO_SCAN_ENABLED=0
# How often the background loop wakes up to check which artworks are due.
AUTO_SCAN_POLL_INTERVAL_SECONDS=21600
# How long since an artwork's last automated scan before it's due again.
AUTO_RESCAN_INTERVAL_SECONDS=604800

# Second, independent scheduled-monitoring mechanism (src/monitor_scheduler.py,
# server.py's _scan_all_artworks / GET,POST /monitor/*) -- unconditionally
# re-sweeps every artwork on a fixed interval (rather than AUTO_SCAN_ENABLED's
# per-artwork "is it due yet" check above), with persistent Vision-quota and
# candidate-dedup bookkeeping. See server.py's module doc for why both
# mechanisms exist side by side. Requires GET {ASSET_SERVICE_URL}/artworks to
# return a list (directly or under artworks/items/data).
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=86400
MONITOR_RETRY_SECONDS=300

# On-chain timestamp anchoring for evidence bundles (src/blockchain_client.py)
# -- reuses blockchain-svc's existing artwork-registration contract call to
# prove "this evidence bundle existed, unaltered, at this on-chain time"
# the same way artwork registration already proves ownership timing.
# Opt-in, off by default: real (if testnet) relayer gas per EVIDENCE_READY
# case, and this project's relayer wallet has run low on testnet funds
# unexpectedly before -- see the relayer-balance-monitoring work elsewhere
# in this repo. Best-effort either way: a failure never fails the case.
EVIDENCE_ANCHOR_ENABLED=0
BLOCKCHAIN_SVC_URL=http://localhost:3001

# Path to rust-core's release binary (see apps/protection-svc/orchestrate.py
# for the same pattern). Falls back to protection-svc's own build if unset.
RUST_CORE_BIN=../protection-svc/rust-core/target/release/rust-core

# Optional. Without this, /scan falls back to pHash + watermark detection
# only -- reverse-image web search is skipped (documented gap, not a hard
# failure). See README.md "What this does not do".
#
# Plain Vision API key (Google Cloud Console -> APIs & Services ->
# Credentials -> Create API key, restrict it to the Vision API), NOT a
# service-account JSON key -- many GCP orgs now block service-account key
# creation by default (iam.disableServiceAccountKeyCreation), and this
# avoids needing one at all.
GOOGLE_VISION_API_KEY=
# Hard monthly cap on Vision API calls this service will make, tracked
# persistently in SQLite (src/db.py's vision_usage table, GET /vision/usage)
# -- does NOT limit calls made against the same key from outside this
# service, so don't share the key with another program. Clamped to <= 999.
VISION_MONTHLY_LIMIT=900

# Optional, scoped bearer auth for candidate image/page fetches
# (evidence_capture.py's capture()) -- sent only to the exact
# comma-separated hostnames in CANDIDATE_AUTH_HOSTS, never to arbitrary
# candidates or redirect destinations. NOTE: currently unused/experimental
# in this service (kept here only as documented, empty-by-default
# placeholders per MOTECTION_HANDOFF.md's own "현재 사용하지 않음" note on
# this exact pair of variables) -- unrelated to api-gateway's own
# DETECTION_SERVICE_TOKEN. Keep any real token in .env only, never commit one.
CANDIDATE_AUTH_BEARER_TOKEN=
CANDIDATE_AUTH_HOSTS=

# Hamming-distance threshold (0-256, 0=identical) below which a candidate
# counts as a likely match. Calibrated against the numbers already measured
# in ml-engine/README.md: same-image round trips land at 0, this project's
# own L3_ANTI_TRAIN cloak output at 6, unrelated images at 138-142.
PHASH_MATCH_THRESHOLD=20

# Watermark payload rust-core embeds today (protection-svc/server.py's own
# default -- see README.md's "known gap" note on why this isn't yet
# per-artwork).
DEFAULT_WATERMARK_HEX=deadbeefcafef00d

# Persistent 256-bit pHash BK-tree catalog (src/phash_index.py, PUT
# /index/artworks/{id}, POST /index/search) -- kept up to date automatically
# by /scan and the monitoring sweep, not just via the standalone endpoints.
PHASH_INDEX_PATH=./data/phash-index.json

# Optional Ed25519 evidence-manifest signing (src/evidence_integrity.py) --
# independent of, and in addition to, EVIDENCE_SIGNING_KEY_ID below being
# used by the *bundle-level* signature via api-gateway/KMS
# (src/evidence_signing.py). Generate a local dev key with
# EvidenceSigner.generate(); keep production keys in a real KMS/HSM, never
# in this file or committed to the repo.
EVIDENCE_SIGNING_KEY=
EVIDENCE_SIGNING_KEY_ID=local-ed25519

# Local write-once emulation (read-only files + .sealed marker) for the
# evidence manifest above. Useful for development but is not a substitute
# for S3 Object Lock/WORM.
EVIDENCE_LOCAL_WRITE_ONCE=false

# Evidence artifact storage backend (src/evidence_store.py). "filesystem"
# (default) keeps evidence in DETECTION_OUT_DIR exactly as before -- no
# behavior change. "local_worm" additionally copies each case's evidence
# into a write-once-emulated store (unique object id, overwrite refusal,
# SHA-256 manifest, append-only audit log) under EVIDENCE_WORM_DIR. Still
# not a substitute for real Object Lock -- an OS admin can bypass local
# file permissions either way.
EVIDENCE_STORE=filesystem
EVIDENCE_WORM_DIR=./worm
EVIDENCE_RETENTION_DAYS=365

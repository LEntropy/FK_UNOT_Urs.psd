ASSET_SERVICE_URL=http://localhost:3002
PORT=8003

# POST /model-leak-reports' one dependency on another service besides
# asset-service -- model-leak detection needs real GPU inference
# (protection-svc/ml-engine's detect_model_leak), which this service can't
# do itself. See src/protection_client.py's module doc.
PROTECTION_SVC_URL=http://localhost:8010
# Caps a caller-submitted suspect-model download (protection_client.py's
# download_suspect_model) -- generous headroom above a typical SD1.5 LoRA
# (tens of MB), not unbounded. See that function's own doc for why this
# exists at all (an externally-controlled URL, unlike everything else this
# service fetches).
MODEL_LEAK_MAX_BYTES=2147483648
# How long POST /model-leak-reports' background case runner waits for
# protection-svc's /detect-model-leak job to finish before giving up and
# marking the case FAILED -- that job actually generates images (the same
# cost class as a real /protect job), not a quick VGG19 pass.
MODEL_LEAK_POLL_TIMEOUT_SECONDS=1800

# POST /internal/notify-evidence-ready -- emails a creator when a case
# reaches EVIDENCE_READY. api-gateway owns the actual SMTP config (its own
# SMTP_* vars); this is just where detection-svc looks for that endpoint.
API_GATEWAY_URL=http://localhost:4000

# Periodic auto-rescan (server.py's _auto_scan_loop) -- opt-in, off by
# default (see server.py's own comment: a background thread doing real
# outbound HTTP at import time would be a surprising side effect for
# every test file, which all import this module). Set to "1" in a real
# deployment so every published artwork gets checked on a rolling
# schedule, not just at upload time or whenever a creator happens to click
# "웹에서 자동 검색".
AUTO_SCAN_ENABLED=0
# How often the background loop wakes up to check which artworks are due.
AUTO_SCAN_POLL_INTERVAL_SECONDS=21600
# How long since an artwork's last automated scan before it's due again.
AUTO_RESCAN_INTERVAL_SECONDS=604800

# Path to rust-core's release binary (see apps/protection-svc/orchestrate.py
# for the same pattern). Falls back to protection-svc's own build if unset.
RUST_CORE_BIN=../protection-svc/rust-core/target/release/rust-core

# Optional. Without this, /scan falls back to pHash + watermark detection
# only -- reverse-image web search is skipped (documented gap, not a hard
# failure). See README.md "What this does not do".
#
# Plain Vision API key (Google Cloud Console -> APIs & Services ->
# Credentials -> Create API key, restrict it to the Vision API), NOT a
# service-account JSON key -- many GCP orgs now block service-account key
# creation by default (iam.disableServiceAccountKeyCreation), and this
# avoids needing one at all.
GOOGLE_VISION_API_KEY=

# Hamming-distance threshold (0-256, 0=identical) below which a candidate
# counts as a likely match. Calibrated against the numbers already measured
# in ml-engine/README.md: same-image round trips land at 0, this project's
# own L3_ANTI_TRAIN cloak output at 6, unrelated images at 138-142.
PHASH_MATCH_THRESHOLD=20

# Watermark payload rust-core embeds today (protection-svc/server.py's own
# default -- see README.md's "known gap" note on why this isn't yet
# per-artwork).
DEFAULT_WATERMARK_HEX=deadbeefcafef00d
